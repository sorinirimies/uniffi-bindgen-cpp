        [](uint64_t uniffi_handle) -> std::optional<uint32_t> {
            uniffi::RustCallStatus uniffi_status{};
            auto uniffi_result = ffi::ffi_sample_rust_future_complete_u32(uniffi_handle, &uniffi_status);
            if (uniffi_status.code == uniffi::CALL_CANCELLED) {
                return std::nullopt;
            }
            uniffi_detail::check_status(uniffi_status);
            return uniffi_result;
        });
}

std::string Thing::name() const {
    uniffi_detail::ensure_init();
    uniffi::RustCallStatus uniffi_status{};
    auto uniffi_result = ffi::uniffi_sample_fn_method_thing_name(uniffi_clone_handle(), &uniffi_status);
    uniffi_detail::check_status(uniffi_status);
    return uniffi_detail::lift_string(uniffi_result);
}

