}

std::string risky(std::string_view s) {
    uniffi_detail::ensure_init();
    uniffi::RustCallStatus uniffi_status{};
    auto uniffi_result = ffi::uniffi_sample_fn_func_risky(uniffi_detail::lower_string(s), &uniffi_status);
    uniffi_detail::check_status(uniffi_status, &uniffi_detail::throw_buf_Oops);
    return uniffi_detail::lift_string(uniffi_result);
}

