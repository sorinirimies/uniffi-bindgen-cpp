}

std::map<std::string, uint32_t> counts() {
    uniffi_detail::ensure_init();
    uniffi::RustCallStatus uniffi_status{};
    auto uniffi_result = ffi::uniffi_sample_fn_func_counts(&uniffi_status);
    uniffi_detail::check_status(uniffi_status);
    return uniffi_detail::lift_buf<std::map<std::string, uint32_t>>(uniffi_result);
}

uniffi::Future<std::string> fetch(std::string_view key) {
    uniffi_detail::ensure_init();
    uint64_t uniffi_future = ffi::uniffi_sample_fn_func_fetch(uniffi_detail::lower_string(key));
    return uniffi::detail::start_future<std::string>(
        uniffi_future, &ffi::ffi_sample_rust_future_poll_rust_buffer, &ffi::ffi_sample_rust_future_cancel_rust_buffer, &ffi::ffi_sample_rust_future_free_rust_buffer,
        [](uint64_t uniffi_handle) -> std::optional<std::string> {
            uniffi::RustCallStatus uniffi_status{};
            auto uniffi_result = ffi::ffi_sample_rust_future_complete_rust_buffer(uniffi_handle, &uniffi_status);
            if (uniffi_status.code == uniffi::CALL_CANCELLED) {
                return std::nullopt;
            }
            uniffi_detail::check_status(uniffi_status);
            return uniffi_detail::lift_string(uniffi_result);
        });
}

std::vector<std::string> names() {
    uniffi_detail::ensure_init();
    uniffi::RustCallStatus uniffi_status{};
    auto uniffi_result = ffi::uniffi_sample_fn_func_names(&uniffi_status);
