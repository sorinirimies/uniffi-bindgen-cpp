Thing::~Thing() {
    if (handle_ != 0) {
        uniffi::RustCallStatus status{};
        ffi::uniffi_sample_fn_free_thing(handle_, &status);
    }
}

uint64_t Thing::uniffi_clone_handle() const {
    uniffi_detail::ensure_init();
    uniffi::RustCallStatus status{};
    uint64_t handle = ffi::uniffi_sample_fn_clone_thing(handle_, &status);
    uniffi_detail::check_status(status);
    return handle;
}

std::shared_ptr<::sample::Thing> Thing::new_(std::string_view name) {
    uniffi_detail::ensure_init();
    uniffi::RustCallStatus uniffi_status{};
    auto uniffi_result = ffi::uniffi_sample_fn_constructor_thing_new(uniffi_detail::lower_string(name), &uniffi_status);
    uniffi_detail::check_status(uniffi_status);
    return uniffi_detail::lift_Thing(uniffi_result);
}

std::shared_ptr<::sample::Thing> Thing::other(uint32_t n) {
    uniffi_detail::ensure_init();
    uniffi::RustCallStatus uniffi_status{};
    auto uniffi_result = ffi::uniffi_sample_fn_constructor_thing_other(n, &uniffi_status);
    uniffi_detail::check_status(uniffi_status);
    return uniffi_detail::lift_Thing(uniffi_result);
}

void Thing::check() const {
    uniffi_detail::ensure_init();
    uniffi::RustCallStatus uniffi_status{};
    ffi::uniffi_sample_fn_method_thing_check(uniffi_clone_handle(), &uniffi_status);
    uniffi_detail::check_status(uniffi_status, &uniffi_detail::throw_buf_Oops);
}

