    return *futures;
}

[[maybe_unused]] void foreign_future_dropped(uint64_t handle) {
    if (handle == 0) {
        return;
    }
    if (auto cancel = foreign_futures().try_remove(handle)) {
        (*cancel)();
    }
}

uniffi::HandleMap<std::shared_ptr<Sink>>& handle_map_Sink() {
    static auto* map = new uniffi::HandleMap<std::shared_ptr<Sink>>();
    return *map;
}

void cb_Sink_free(uint64_t handle) {
    (void)handle_map_Sink().try_remove(handle);
}

uint64_t cb_Sink_clone(uint64_t handle) {
    try {
        return handle_map_Sink().clone(handle);
    } catch (...) {
        return 0;
    }
}

void cb_Sink_m0(uint64_t uniffi_handle, uniffi::RustBuffer arg0, void* uniffi_out_return, uniffi::RustCallStatus* uniffi_call_status) {
    try {
        auto object = handle_map_Sink().get(uniffi_handle);
        object->push(uniffi_detail::lift_string(arg0));
        (void)uniffi_out_return;
    } catch (const std::exception& error) {
        (*uniffi_call_status).code = uniffi::CALL_UNEXPECTED_ERROR;
        (*uniffi_call_status).error_buf = uniffi_detail::lower_string(error.what());
    } catch (...) {
        (*uniffi_call_status).code = uniffi::CALL_UNEXPECTED_ERROR;
        (*uniffi_call_status).error_buf = uniffi_detail::lower_string("unknown exception");
    }
}

void cb_Sink_m1(uint64_t uniffi_handle, uint32_t* uniffi_out_return, uniffi::RustCallStatus* uniffi_call_status) {
    try {
        auto object = handle_map_Sink().get(uniffi_handle);
        auto result = object->count();
        *uniffi_out_return = result;
    } catch (const ::sample::Oops& error) {
        (*uniffi_call_status).code = uniffi::CALL_ERROR;
        (*uniffi_call_status).error_buf = uniffi_detail::lower_error(error);
    } catch (const std::exception& error) {
        (*uniffi_call_status).code = uniffi::CALL_UNEXPECTED_ERROR;
        (*uniffi_call_status).error_buf = uniffi_detail::lower_string(error.what());
    } catch (...) {
        (*uniffi_call_status).code = uniffi::CALL_UNEXPECTED_ERROR;
        (*uniffi_call_status).error_buf = uniffi_detail::lower_string("unknown exception");
    }
}

