/// Frees a Rust buffer when it goes out of scope.
struct BufferGuard {
    uniffi::RustBuffer buffer;
    ~BufferGuard() {
        uniffi::RustCallStatus status{};
        ffi::ffi_sample_rustbuffer_free(buffer, &status);
    }
};

[[maybe_unused]] uniffi::RustBuffer buffer_from_bytes(const uint8_t* data, size_t len) {
    uniffi::ForeignBytes bytes{static_cast<int32_t>(len), data};
    uniffi::RustCallStatus status{};
    uniffi::RustBuffer buffer = ffi::ffi_sample_rustbuffer_from_bytes(bytes, &status);
    if (status.code != uniffi::CALL_SUCCESS) {
        uniffi::detail::fail<uniffi::InternalError>("could not allocate a Rust buffer");
    }
    return buffer;
}

using Thrower = void (*)(uniffi::RustBuffer);

[[maybe_unused]] void check_status(uniffi::RustCallStatus& status, Thrower thrower = nullptr) {
    switch (status.code) {
        case uniffi::CALL_SUCCESS:
            return;
        case uniffi::CALL_ERROR:
            if (thrower != nullptr) {
                thrower(status.error_buf);
            }
            {
                BufferGuard guard{status.error_buf};
            }
            uniffi::detail::fail<uniffi::InternalError>("the call failed with an error the bindings do not expect");
        case uniffi::CALL_UNEXPECTED_ERROR: {
            std::string message = "Rust panic";
            BufferGuard guard{status.error_buf};
            if (status.error_buf.len > 0) {
                message.assign(reinterpret_cast<const char*>(status.error_buf.data),
                               static_cast<size_t>(status.error_buf.len));
            }
            uniffi::detail::fail<uniffi::PanicError>(message);
        }
        case uniffi::CALL_CANCELLED:
            uniffi::detail::fail<uniffi::CancelledError>();
        default:
            uniffi::detail::fail<uniffi::InternalError>("unexpected RustCallStatus code");
    }
}

template <class T>
uniffi::RustBuffer lower_buf(const T& value) {
    uniffi::Writer writer;
    uniffi::Codec<T>::write(writer, value);
    return buffer_from_bytes(writer.bytes().data(), writer.bytes().size());
}

template <class T>
T lift_buf(uniffi::RustBuffer buffer) {
    BufferGuard guard{buffer};
    uniffi::Reader reader(buffer.data, static_cast<size_t>(buffer.len));
    T value = uniffi::Codec<T>::read(reader);
    if (reader.has_remaining()) {
        uniffi::detail::fail<uniffi::InternalError>("the buffer still has data after lifting its containing value");
    }
    return value;
}

template <class E>
uniffi::RustBuffer lower_error(const E& error) {
    uniffi::Writer writer;
    uniffi::Codec<std::shared_ptr<E>>::write_value(writer, error);
    return buffer_from_bytes(writer.bytes().data(), writer.bytes().size());
}

[[maybe_unused]] uniffi::RustBuffer lower_string(std::string_view value) {
    return buffer_from_bytes(reinterpret_cast<const uint8_t*>(value.data()), value.size());
}

[[maybe_unused]] std::string lift_string(uniffi::RustBuffer buffer) {
    BufferGuard guard{buffer};
    return std::string(reinterpret_cast<const char*>(buffer.data), static_cast<size_t>(buffer.len));
}

