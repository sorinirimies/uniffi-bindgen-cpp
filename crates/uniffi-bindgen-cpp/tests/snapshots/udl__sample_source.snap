std::shared_ptr<Thing> lift_Thing(uint64_t handle) {
    return std::make_shared<Thing>(uniffi::HandleTag{}, handle);
}

uint64_t lower_Thing(const std::shared_ptr<Thing>& value) {
    return value->uniffi_clone_handle();
}

std::shared_ptr<Sink> lift_Sink(uint64_t handle) {
    return handle_map_Sink().get(handle);
}

uint64_t lower_Sink(const std::shared_ptr<Sink>& value) {
    return handle_map_Sink().insert(value);
}

[[noreturn]] void throw_buf_Detailed(uniffi::RustBuffer buffer) {
    BufferGuard guard{buffer};
    uniffi::Reader reader(buffer.data, static_cast<size_t>(buffer.len));
    uniffi::Codec<std::shared_ptr<::sample::Detailed>>::read(reader)->uniffi_throw();
    std::abort();  // not reached; GCC does not take [[noreturn]] from a virtual call
}

[[noreturn]] void throw_buf_Oops(uniffi::RustBuffer buffer) {
    BufferGuard guard{buffer};
    uniffi::Reader reader(buffer.data, static_cast<size_t>(buffer.len));
    uniffi::Codec<std::shared_ptr<::sample::Oops>>::read(reader)->uniffi_throw();
    std::abort();  // not reached; GCC does not take [[noreturn]] from a virtual call
}

